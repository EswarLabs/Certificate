  "main": "src/server.js",
  "scripts": {
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles --runInBand",
    "test:watch": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "worker": "cross-env NODE_ENV=production node src/worker.js",
    "dev:server": "cross-env NODE_ENV=development nodemon src/server.js",
    "dev:worker": "cross-env NODE_ENV=development nodemon src/worker.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:worker\""
  },
  "type": "module",
