// ============================================================
// GENERATORS & DATASOURCE
// ============================================================
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  ISSUER
  VIEWER
}

enum TemplateOrientation {
  LANDSCAPE
  PORTRAIT
}

enum CredentialStatus {
  DRAFT
  ISSUED
  REVOKED
  EXPIRED
}

enum CredentialEventType {
  CREATED
  ISSUED
  EMAILED
  OPENED
  VERIFIED
  REVOKED
  EXPIRED
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum JobType {
  BULK_ISSUE
  BULK_EMAIL
  PDF_GENERATION
  IMAGE_GENERATION
  CSV_IMPORT
}

// ============================================================
// MODELS
// ============================================================

model User {
  id        String   @id @default(cuid())
  firstName String?
  lastName  String?
  email     String   @unique
  avatarUrl String?
  password  String?
  googleId  String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  templates      CertificateTemplate[]
  credentials    Credential[]
  uploadedFiles  File[]
  creatorProfile CreatorProfile?

  @@index([email])
}

enum OrgVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  logoUrl         String?
  credentialLimit Int      @default(1000)
  credentialsUsed Int      @default(0)
  metadata        Json?

  // Organization Verification fields
  isVerified          Boolean               @default(false)
  verificationStatus  OrgVerificationStatus @default(UNVERIFIED)
  verifiedDomain      String?
  verificationMethod  String?               // e.g. "DNS_TXT"
  verificationToken   String?               @unique
  verifiedAt          DateTime?
  verificationExpiry  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces  Workspace[]
  memberships Membership[]
  credentials Credential[]

  @@index([slug])
}

model Workspace {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  slug             String?
  brandingSettings Json?
  customDomain     String?
  smtpEnabled      Boolean  @default(false)
  smtpSettings     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  templates   CertificateTemplate[]
  credentials Credential[]
  jobs        Job[]
  files       File[]
  memberships Membership[]

  /// Storage quota tracking
  storageUsedBytes  BigInt  @default(0)
  storageLimitBytes BigInt  @default(104857600) // 100 MB default

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Membership {
  id             String        @id @default(cuid())
  userId         String
  organizationId String
  workspaceId    String
  role           WorkspaceRole

  joinedAt DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([organizationId])
  @@index([workspaceId])
  @@index([role])
}

/// Stores a Konva-compatible canvas design in editorData (JSONB).
/// htmlTemplate and cssStyles have been replaced — all rendering
/// is driven by editorData via the renderEditorData utility.
model CertificateTemplate {
  id          String              @id @default(cuid())
  workspaceId String
  createdById String

  name        String
  description String?

  orientation  TemplateOrientation @default(LANDSCAPE)
  thumbnailUrl String?

  /// Konva canvas JSON: { version, width, height, background, elements[] }
  editorData Json

  /// Auto-incremented on every save
  templateVersion Int @default(1)

  /// Publish workflow — only published templates can be used for new credentials
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  /// Zod-validated field schema for credential data injection
  schemaDefinition Json

  /// Optional ID of the public marketplace template this was cloned from
  copiedFromPublicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User       @relation(fields: [createdById], references: [id])
  credentials Credential[]

  @@index([workspaceId])
  @@index([createdById])
  @@index([isPublished])
  @@index([workspaceId, isPublished])
}

model Credential {
  id             String           @id @default(cuid())
  workspaceId    String
  organizationId String
  templateId     String
  createdById    String

  recipientName  String
  recipientEmail String?

  /// Arbitrary key-value pairs matching the template schemaDefinition
  credentialData Json

  verificationCode String           @unique
  status           CredentialStatus @default(DRAFT)

  pdfUrl   String?
  imageUrl String?

  /// SHA-256 hash of credential content at issuance (for integrity verification)
  contentHash String?

  issuedAt  DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     CertificateTemplate @relation(fields: [templateId], references: [id])
  createdBy    User                @relation(fields: [createdById], references: [id])

  events    CredentialEvent[]
  emailLogs EmailLog[]

  @@index([workspaceId])
  @@index([organizationId])
  @@index([templateId])
  @@index([status])
  @@index([recipientEmail])
  @@index([verificationCode])
  @@index([workspaceId, status])
  @@index([createdById])
  @@index([issuedAt])
}

model CredentialEvent {
  id           String              @id @default(cuid())
  credentialId String
  eventType    CredentialEventType
  ipAddress    String?
  userAgent    String?
  metadata     Json?

  createdAt DateTime @default(now())

  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId])
  @@index([eventType])
  @@index([credentialId, eventType])
}

model EmailLog {
  id                String      @id @default(cuid())
  credentialId      String
  recipientEmail    String
  providerMessageId String?
  status            EmailStatus @default(QUEUED)
  bounceReason      String?
  openedAt          DateTime?
  clickedAt         DateTime?

  createdAt DateTime @default(now())

  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId])
  @@index([status])
  @@index([recipientEmail])
}

model Job {
  id           String    @id @default(cuid())
  workspaceId  String
  type         JobType
  status       JobStatus @default(PENDING)
  progress     Int       @default(0)
  payload      Json?
  result       Json?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
  @@index([type])
  @@index([workspaceId, status])
}

model File {
  id           String  @id @default(cuid())
  workspaceId  String
  uploadedById String
  fileName     String
  mimeType     String
  fileSize     BigInt
  storageKey   String  @unique
  publicUrl    String?
  metadata     Json?

  createdAt DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id])

  @@index([workspaceId])
  @@index([uploadedById])
  @@index([mimeType])
}

// ============================================================
// MARKETPLACE ENUMS & MODELS
// ============================================================

enum MarketplaceVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
  SUSPENDED
}

model CreatorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String?
  websiteUrl      String?
  organization    String?
  isVerified      Boolean  @default(false)
  totalViews      Int      @default(0)
  totalDownloads  Int      @default(0)
  totalCopies     Int      @default(0)
  averageRating   Float    @default(0.0)
  achievements    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  templates       PublicTemplate[]
}

model PublicTemplate {
  id              String                @id @default(cuid())
  originalId      String?
  creatorId       String
  creator         CreatorProfile        @relation(fields: [creatorId], references: [id])
  title           String
  description     String
  coverImageUrl   String?
  thumbnailUrl    String?
  previewPages    Json?
  visibility      MarketplaceVisibility @default(PUBLIC)
  moderation      ModerationStatus      @default(APPROVED)
  difficulty      DifficultyLevel       @default(BEGINNER)
  industry        String                @default("General")
  language        String                @default("en")
  themeColors     Json?
  fontInfo        Json?
  editorData      Json
  schemaDefinition Json
  version         Int                   @default(1)
  license         String                @default("CC-BY-4.0")
  
  viewsCount       Int                  @default(0)
  uniqueViewsCount Int                  @default(0)
  copiesCount      Int                  @default(0)
  downloadsCount   Int                  @default(0)
  likesCount       Int                  @default(0)
  favoritesCount   Int                  @default(0)
  popularityScore  Float                @default(0.0)
  trendingScore    Float                @default(0.0)
  ratingScore      Float                @default(0.0)
  reviewsCount     Int                  @default(0)

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  versions         PublicTemplateVersion[]
  categories       TemplateCategory[]      @relation("TemplateToCategory")
  tags             PublicTemplateTag[]     @relation("TemplateToTag")
  likes            PublicTemplateLike[]
  favorites        PublicTemplateFavorite[]
  usages           PublicTemplateUsage[]
  reports          PublicTemplateReport[]
  views            PublicTemplateView[]
  featured         FeaturedTemplates?

  @@index([visibility, moderation])
  @@index([trendingScore(sort: Desc)])
  @@index([popularityScore(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([industry])
}

model PublicTemplateVersion {
  id               String         @id @default(cuid())
  publicTemplateId String
  publicTemplate   PublicTemplate @relation(fields: [publicTemplateId], references: [id], onDelete: Cascade)
  versionNumber    Int
  changelog        String?
  editorData       Json
  schemaDefinition Json
  createdAt        DateTime       @default(now())

  @@unique([publicTemplateId, versionNumber])
}

model TemplateCategory {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  description String?
  iconUrl     String?
  templates   PublicTemplate[] @relation("TemplateToCategory")
}

model PublicTemplateTag {
  id        String           @id @default(cuid())
  name      String           @unique
  slug      String           @unique
  templates PublicTemplate[] @relation("TemplateToTag")
}

model PublicTemplateLike {
  id               String         @id @default(cuid())
  publicTemplateId String
  publicTemplate   PublicTemplate @relation(fields: [publicTemplateId], references: [id], onDelete: Cascade)
  userId           String
  createdAt        DateTime       @default(now())

  @@unique([publicTemplateId, userId])
}

model PublicTemplateFavorite {
  id               String         @id @default(cuid())
  publicTemplateId String
  publicTemplate   PublicTemplate @relation(fields: [publicTemplateId], references: [id], onDelete: Cascade)
  userId           String
  createdAt        DateTime       @default(now())

  @@unique([publicTemplateId, userId])
}

model PublicTemplateUsage {
  id               String         @id @default(cuid())
  publicTemplateId String
  publicTemplate   PublicTemplate @relation(fields: [publicTemplateId], references: [id])
  organizationId   String
  workspaceId      String
  copiedTemplateId String
  userId           String
  createdAt        DateTime       @default(now())

  @@index([publicTemplateId])
  @@index([organizationId])
}

model PublicTemplateReport {
  id               String         @id @default(cuid())
  publicTemplateId String
  publicTemplate   PublicTemplate @relation(fields: [publicTemplateId], references: [id], onDelete: Cascade)
  reporterUserId   String
  reason           String
  details          String?
  status           String         @default("OPEN")
  createdAt        DateTime       @default(now())
}

model PublicTemplateView {
  id               String         @id @default(cuid())
  publicTemplateId String
  publicTemplate   PublicTemplate @relation(fields: [publicTemplateId], references: [id], onDelete: Cascade)
  viewerIpHash     String
  userId           String?
  createdAt        DateTime       @default(now())

  @@index([publicTemplateId, viewerIpHash])
  @@index([createdAt])
}

model FeaturedTemplates {
  id               String         @id @default(cuid())
  publicTemplateId String         @unique
  publicTemplate   PublicTemplate @relation(fields: [publicTemplateId], references: [id], onDelete: Cascade)
  section          String
  displayOrder     Int            @default(0)
  createdAt        DateTime       @default(now())
}